It will list all kubernetes pods
kubectl get pod 

it will delete the pod
kubectl delete pod "pod name"

kubectl create -f "file name"

It will list all the NODE
kubectl get node


kubectl get rs

kubectl get deployments.apps

kubectl describe deployment.apps


kubectl apply -f "file name"

aws eks update-kubeconfig --name my-lab-cluster --region ap-south-1


kubectl describe deployments.apps nginx-deployment

kubectl describe rs nginx-deployment-96b9d695

kubectl describe pod nginx-deployment-96b9d695-7jjqw


kubectl scale deployment nginx-deployment --replicas=6

This is command is very risky
kubectl edit deployments.apps "deployment name"


kubectl set image deployment/nginx-deployment nginx=nginx:1.23.3
