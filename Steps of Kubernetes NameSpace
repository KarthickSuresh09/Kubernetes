Step 1: create namespace yaml file
apiVersion: v1
kind: Namespace
metadata:
  name: dev-namespace


Step 2: Now you can run command 
kubectl apply -f namespace.yml
 AND verfiy with this command
kubectl get ns (OR) kubectl get namespace
NAME              STATUS   AGE
default           Active   85m
dev-namespace     Active   35s
kube-node-lease   Active   85m
kube-public       Active   85m
kube-system       Active   85m



Step 3: create a yaml file to create custom namespace 

 apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx
  namespace: dev-namespace    # Deploy in this namespace
spec:
  replicas: 2                # Number of Pods
  selector:
    matchLabels:
      app: nginx             # Match Pods with this label
  template:
    metadata:
      labels:
        app: nginx           # Pod label
    spec:
      containers:
        - name: nginx
          image: nginx:latest
          ports:
            - containerPort: 80


Step 4: now run a yaml file to create a namespace with this command
kubectl apply -f nginx-deployment.yml

Step 5: verfiy with this command
kubectl get pod -n dev-namespace
